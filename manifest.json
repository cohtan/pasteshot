{
  "manifest_version": 3,
  "name": "PasteShot",
  "short_name": "PasteShot",
  "version": "0.3.0",
  "description": "見ているページ全体を、スクロール分も含めて1枚の画像にします。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "offscreen", "storage"],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "ページ全体を画像にする",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
